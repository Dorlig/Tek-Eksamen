<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Tilmeld</title>
</head>
<body>
    <div id="content">

        <div style="height: 40%;"></div>

        <h1 class="useTextColor">Tilmeld</h1>

        <p></p>

        <form action="/signUp" method="post" id="formContainer">
            <input type="text" name="username" id="username" placeholder="Brugernavn" class="inversedColor rounded formOption">
            <input type="email" name="email" id="email" placeholder="Email" class="inversedColor rounded formOption">
            <input type="password" name="password" id="password" placeholder="Adgangskode" class="inversedColor rounded formOption">
            <button type="submit" class="filledButton formSubmit">Opret</button>
        </form>
    </div>

    <!-- <script src="/scripts/login.js"></script> -->
</body>
</html>