<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <title>Profil</title>
</head>

<body>
    <div id="content">
        <h1 class="useTextColor">Profil</h1>

        <form action="/profile/<%= username %>" method="post" id="profileFormContainer">
            <input type="number" min="16" max="99" name="age" id="age" placeholder="Alder"
                value="<%= profile.age < 0 ? "" : profile.age %>" required class="inversedColor rounded">
            <textarea name="description" class="inversedColor" placeholder="Opret en beskrivelse af dig selv"
            required><%= profile.description %></textarea>

            <input type="text" id="variableJSON" name="interests" hidden
                value="<%= JSON.stringify(profile.interests); %>">
            <div class="interests">
                <div class="search">
                    <input type="text" class="inversedColor searchBar" id="searchBar" list="categories" autocomplete="off" placeholder="Søg efter interesse.">
                    <datalist class="categories" id="categories">
                        <option value="Sport"></option>
                        <option value="Computerspil"></option>
                        <option value="Underholdning"></option>
                        <option value="Musik"></option>
                        <option value="Skole"></option>
                    </datalist>
                    <button type="button" class="removeBtn">
                        <img src="/images/Trashcan.png" alt="trashcan" style="width: 100%; aspect-ratio: 1;">
                        <!-- <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                            class="bi bi-trash removeImage" viewBox="0 0 16 16">
                            <path
                                d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                            <path fill-rule="evenodd"
                                d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4L4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z" />
                        </svg> -->
                    </button>
                </div>
                <div class="results">
                    <div class="resultsGrid">
                    </div>
                </div>
            </div>

            <button type="submit" class="filledButton formSubmit">Gem</button>
        </form>

    </div>
    
    <%- include('partials/footer') %>
    
    <script src="/scripts/profile.js"></script>
</body>

</html>