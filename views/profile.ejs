<body>
    <div id="content">
        <h1>Profil</h1>

        <form action="/profile/<%= username %>" method="post" id="profileFormContainer">
            <input type="number" min="16" max="99" name="age" id="age" placeholder="Alder" value="<%= profile.age < 0 ? "" : profile.age %>" style="color: black;">
            <textarea name="description" id="description" placeholder="Opret en beskrivelse om dig selv" style="color: black;"><%= profile.description %></textarea>

            <input type="text" id="variableJSON" name="interests" hidden value="<%= JSON.stringify(profile.interests); %>">
            <div class="interests">
                <div class="search">
                    <input type="text" class="searchBar" id="searchBar" list="categories" autocomplete="off">
                    <datalist class="categories" id="categories">
                        <option value="Sport"></option>
                        <option value="Computerspil"></option>
                        <option value="Underholdning"></option>
                        <option value="Musik"></option>
                        <option value="Skole"></option>
                    </datalist>
                    <button type="button" class="searchBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                    </button>
                    <button type="button" class="removeBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z"/>
                            <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1zM4.118 4L4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4H4.118zM2.5 3V2h11v1h-11z"/>
                        </svg>
                    </button>
                </div>
                <div class="results">
                    <div class="resultsGrid">
                    </div>
                </div>
            </div>

            <button type="submit">Gem</button>
        </form>
    
        <%-  include('partials/footer') %>
    </div>

    <script src="/scripts/profile.js"></script>
</body>
