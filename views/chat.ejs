<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Beskeder</title>
</head>

<body>
    <span id="extraInfo" hidden><%= username+"-"+targetName %></span>

    <div id="content">
        <div class="top chatHeader">
            <a href="/friends/<%= username %>">
                <div class="backBtn">
                    <img src="/images/Back.png" alt="back" class="chatBackImage">
                </div>
            </a>
            <h1 class="chatName useTextColor">
                <%= targetName %>
            </h1>
            <div class="chatFriendBtn">
                <img src="/images/FriendHeart.png" alt="heart" class="chatFriendImage">
            </div>
        </div>

        <div class="chatOuter">

            <div class="messages" id="messages">
                <% for(let i=0; i < messages.length; i++) { %>
                    <div class="message <%= messages[i].origin === username ? " right" : "left" %>">
                        <div class="messageText chatMessageContent">
                            <%= messages[i].content %>
                        </div>
                        <div class="messageText messageTimestamp">
                            <%= messages[i].time %>
                        </div>
                    </div>
                    <% } %>
            </div>

        </div>

        <form action="/chat/<%= username %>-<%= targetName %>" method="post" id="chatForm">
            <input type="text" name="messageContent" id="messageContent"  placeholder="Skriv her" class="inversedColor rounded chatMessageInput">
            <button type="submit" class="chatSend filledButton">
                <img src="/images/Send.png" alt="send" class="sendImage">
            </button>

        </form>

        <%- include('partials/footer') %>
    </div>

    <script src="/scripts/chat.js"></script>
</body>

</html>