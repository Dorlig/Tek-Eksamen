<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aktiviteter</title>
</head>
<body>
    <div id="content">
        <h1>Aktiviteter</h1>
    
        <% for (let i = 0; i < activities.length; i++)  { %>
            <div class="activityContainer">
                <h3><%= activities[i].title %></h3>
                <p><%= activities[i].created %></p>
                <p><%= activities[i].description %></p>
                <p><%= activities[i].participants.length %> har accepteret</p>
            </div>

        <% } %>

        <%-  include('partials/footer') %>
    </div>
</body>
</html>