<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Aktiviteter</title>
</head>
<body>
    <div id="content">
        <h1 class="useTextColor">Aktiviteter</h1>

        <div class="activitiesContainer">

            <% for (let i = 0; i < userActivities.length; i++)  { %>
                <a href="/activity/<%= username+"-"+userActivities[i].creator %>/<%= i %>" class="userActivityContainer activityContainer" style="text-decoration: none">
                    <div class="activityDiv">
                        <h3 class="activityTitle"><%= userActivities[i].title %></h3>
                        <h3 class="activityCreator">af <%= userActivities[i].creator %></h3>
                        <p class="activityDescription"><%= userActivities[i].description %></p>
                        <p class="activityParticipants"><%= userActivities[i].participants.length %> har accepteret</p>
                        <p class="activityCreated">Oprettet: <%= userActivities[i].created %></p>
                    </div>
                </a>
            
            <% } %>
            <div style="background-color: green; width: 80%; height: 2px;"></div>
            
            <% for (let i = 0; i < activities.length; i++)  { %>
                <a href="/activity/<%=  username+"-"+activities[i].creator %>/<%= activities[i].id %>" class="activityContainer activityContainer" style="text-decoration: none">
                    <div class="activityDiv">
                        <h3 class="activityTitle"><%= activities[i].title %></h3>
                        <h4 class="activityCreator">af <%= activities[i].creator %></h4>
                        <p class="activityDescription"><%= activities[i].description %></p>
                        <p class="activityParticipants"><%= activities[i].participants.length %> har accepteret</p>
                        <p class="activityCreated">Oprettet: <%= activities[i].created %></p>
                    </div>
                </a>
    
            <% } %>
        </div>
            
        

        <a href="/createActivity/<%= username %>"><button class="filledButton activityCreateButton">Opret Aktivitet</button></a>

        <%-  include('partials/footer') %>
    </div>
</body>
</html>