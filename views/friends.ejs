<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Venner</title>
</head>
<body>
    <div id="content">
        <h1 class="useTextColor">Venner</h1>

        <div id="friendsContainer">

            
            <% for (let i = 0; i < friends.length; i++)  { %>
                <a href="/chat/<%= username %>-<%= friends[i] %>" style="text-decoration: none;" class="friendContainer">
                    <div class="friendDiv">
                        <h3 class="useTextColor friendName"><%= friends[i] %></h3>
                        <p class="friendLastMessage"> <%= messages[friends[i]].origin %>: <%= messages[friends[i]].content %> </p>
                        <!-- <p><%= messages[friends[i]].time %> </p> -->
                    </div>
                </a>
                
            <% } %>
                
        </div>

    </div>
    
    <%-  include('partials/footer') %>

</body>
</html>