<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Lav Aktivitet</title>
</head>
<body>
    <div id="content">
        <h1 class="useTextColor">Lav Aktivitet</h1>

        <form action="/createActivity/<%= username%>" method="post" id="activityFormContainer">
            <input type="text" name="title" id="titleInput" class="inversedColor rounded" required placeholder="Skriv titlen her">
            <textarea name="description" id="descriptionInput" class="inversedColor" required placeholder="Skriv beskrivelsen her"></textarea>

            <ul id="friendList">

            </ul>
            <span hidden id="totalFriends"><%= friends.join(" ") %></span>

            <input type="text" name="friends" id="friendsinput" hidden>
            <div class="">
                <input list="friendsList" class="inversedColor" name="friendsList" id="friendsListInput" placeholder="Inviter ven.">
                <datalist id="friendsList">
                    <% for (const friend of friends) { %>
                        <option value="<%= friend %>">
                    <% } %>
                </datalist>
    
                <button type="button" class="inversedColor" id="addFriend">Tilføj</button>
            </div>

            <button type="submit" class="filledButton activityFormSubmit">Opret</button>
        </form>
    
    </div>
    <%-  include('partials/footer') %>

    <script src="/scripts/createActivity.js"></script>
</body>
</html>