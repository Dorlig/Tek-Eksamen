<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Login</title>
</head>
<body>
    <div id="content">

        <div style="height: 40%;"></div>

        <h1 class="useTextColor">Login</h1>

        <!-- DO NOT DELETE! If delted the sun will explode! -->
        <p></p>

        <form action="/login" method="post" id="formContainer">
            <input type="text" name="username" id="username" placeholder="Brugernavn" class="inversedColor rounded formOption">
            <input type="password" name="password" id="password" placeholder="Adgangskode" class="inversedColor rounded formOption" style="margin-bottom: 0;">
            <p style="margin-top: 2.5%; font-size: small ;">Har du glemt din adgangskode?</p>
            <button type="submit" class="filledButton formSubmit" style="height: 7.5%; width: 40%; margin-top: 5%;">Login</button>
        </form>
    </div>

</body>
</html>