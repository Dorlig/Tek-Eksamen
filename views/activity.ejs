<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Aktivitet</title>
</head>
<body>
    <div id="content">
        <div class="activityContent">
            <h1 class="activityTitle useTextColor"><%= activity.title %></h1>
            <h2 class="activityCreator">Oprettet af <%= activity.creator %></h2>
            <p class="activityDescription"><%= activity.description %></p>
            <h3 class="activityCreated">Oprettet den <%= activity.created %></h3>
    
            <p><%= activity.participants.length == 0 ? "Ingen har accepteret indtil videre" : activity.participants.join(" ") + " har accepteret" %></p>
        </div>

        <% if (username != activity.creator) { %>
        <div class="">
            <% if (activity.participants.includes(username)) { %>
                <form action="/activity/<%=  username+"-"+activity.creator %>/<%= id %>/remove" method="post">
                    <button class="filledButton activityAccept">Afmled</button>
                </form>
            <% } %>
            <form action="/activity/<%=  username+"-"+activity.creator %>/<%= id %>/join" method="post">
                <button class="filledButton activityAccept">Tilmeld</button>
            </form>
        </div>
        <% } %>
    
        <%-  include('partials/footer') %>
    </div>
</body>
</html>